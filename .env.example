# Triada Network — configuration template.
# Copy to .env and edit. All variables use the CPM_ prefix.

# API server
CPM_HOST=127.0.0.1
CPM_PORT=8000

# Comma-separated allowed CORS origins (the frontend dev server)
CPM_CORS_ORIGINS=http://localhost:3000

# Optional API key for machine clients. Leave empty to disable (local-only use).
# Human login is separate: create an account with `camoufox-pm user add <name>`.
CPM_API_KEY=

# Login session lifetime in hours (default 168 = one week).
CPM_SESSION_TTL_HOURS=168

# Force the Secure flag on the session cookie. Set to 1 behind a
# TLS-terminating reverse proxy, where the app itself sees plain HTTP.
CPM_SECURE_COOKIES=0

# SQLite database path
CPM_DB_PATH=data/profiles.db

# Override where the bundled web UI is served from. Leave empty to use the
# package's own webui/ directory, then web/out when running from source.
CPM_WEBUI_DIR=

# Encryption key for proxy credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CPM_SECRET_KEY=

# Maximum accepted uploaded profile archive size in bytes (default 1 GiB).
CPM_MAX_IMPORT_BYTES=1073741824

# Cloud control plane
CPM_CLOUD_ENABLED=1
# Optional hosted control-plane URL. Empty = embedded/local control plane.
CPM_CLOUD_BASE_URL=
CPM_CLOUD_SYNC_INTERVAL_SECONDS=30

# v1.0 Cloud Control Plane
TRIADA_POSTGRES_PASSWORD=change-me
TRIADA_CLOUD_JWT_SECRET=change-this-to-a-long-random-secret
